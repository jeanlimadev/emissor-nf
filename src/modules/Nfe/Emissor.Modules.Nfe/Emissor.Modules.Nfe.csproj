<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\building-blocks\Emissor.BuildingBlocks\Emissor.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Emitentes\Emissor.Modules.Emitentes\Emissor.Modules.Emitentes.csproj" />
    <ProjectReference Include="..\..\..\contracts\Emissor.Contracts\Emissor.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Fica so em Infrastructure, atras das portas INfeXmlBuilder/ISefazGateway. -->
    <PackageReference Include="Zeus.Net.NFe.NFCe" />
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

  <ItemGroup>
    <!-- Schemas oficiais do layout 4.00 (PL_010, com NT 2025.002), embutidos para a
         validacao XSD nao depender de arquivo em disco. -->
    <EmbeddedResource Include="Infrastructure\Xml\Schemas\*.xsd" LogicalName="Schemas/%(Filename)%(Extension)" />
    <!-- Raizes da ICP-Brasil (baixadas de http://acraiz.icpbrasil.gov.br/credenciadas/RAIZ/ em 12/10/2026):
         os webservices da SEFAZ usam certificados TLS dessa cadeia, que nao vem no Linux. -->
    <EmbeddedResource Include="Infrastructure\Sefaz\CadeiaIcpBrasil\*.crt" LogicalName="CadeiaIcpBrasil/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
